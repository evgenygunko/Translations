> {%
  client.test('Translate supplied coche model to Russian', () => {
    client.assert(response.status === 200, "Response status is 200");
    client.assert(response.body.word === "coche", "Word is preserved");
    client.assert(response.body.sourceLanguage === 1, "Source language is preserved");
    client.assert(response.body.definition.headword.original === "coche", "Headword is preserved");
    client.assert(response.body.definition.partOfSpeech === "sustantivo", "Part of speech is preserved");
    client.assert(typeof response.body.definition.headword.english === "string" && response.body.definition.headword.english.length > 0, "English headword is populated");
    client.assert(typeof response.body.definition.headword.translation === "string" && response.body.definition.headword.translation.length > 0, "Russian headword is populated");
    client.assert(response.body.definition.contexts.length === 4, "Contexts are preserved");
    client.assert(response.body.definition.contexts[0].meanings.length === 1, "Meanings are preserved");
    client.assert(response.body.definition.contexts[0].meanings[0].original === "car", "Original meaning is preserved");
    client.assert(typeof response.body.definition.contexts[0].meanings[0].translation === "string" && response.body.definition.contexts[0].meanings[0].translation.length > 0, "Russian meaning is populated");
    client.assert(response.body.definition.contexts[0].meanings[0].lookupUrl === "https://www.spanishdict.com/translate/coche", "Lookup URL is preserved");
    client.assert(response.body.definition.contexts[1].meanings.length === 1, "Meanings are preserved");
    client.assert(response.body.definition.contexts[1].meanings[0].original === "carriage", "Original meaning is preserved");
    client.assert(typeof response.body.definition.contexts[1].meanings[0].translation === "string" && response.body.definition.contexts[1].meanings[0].translation.length > 0, "Russian meaning is populated");
    client.assert(response.body.definition.contexts[1].meanings[0].lookupUrl === "https://www.spanishdict.com/translate/coche", "Lookup URL is preserved");
    client.assert(response.body.definition.contexts[2].meanings.length === 1, "Meanings are preserved");
    client.assert(response.body.definition.contexts[2].meanings[0].original === "coach", "Original meaning is preserved");
    client.assert(typeof response.body.definition.contexts[2].meanings[0].translation === "string" && response.body.definition.contexts[2].meanings[0].translation.length > 0, "Russian meaning is populated");
    client.assert(response.body.definition.contexts[2].meanings[0].lookupUrl === "https://www.spanishdict.com/translate/coche", "Lookup URL is preserved");
    client.assert(response.body.definition.contexts[3].meanings.length === 1, "Meanings are preserved");
    client.assert(response.body.definition.contexts[3].meanings[0].original === "baby carriage", "Original meaning is preserved");
    client.assert(typeof response.body.definition.contexts[3].meanings[0].translation === "string" && response.body.definition.contexts[3].meanings[0].translation.length > 0, "Russian meaning is populated");
    client.assert(response.body.definition.contexts[3].meanings[0].lookupUrl === "https://www.spanishdict.com/translate/coche", "Lookup URL is preserved");
    client.assert(JSON.stringify(response.body.variants) === JSON.stringify([]), "variants are preserved");
    client.assert(JSON.stringify(response.body.expressions) === JSON.stringify([]), "expressions are preserved");
  });
%}
