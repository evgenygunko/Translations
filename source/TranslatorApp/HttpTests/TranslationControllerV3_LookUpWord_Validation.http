### Reject the obsolete dictionary lookup payload

POST {{HostAddress}}/api/v3/Translation/LookUpWord?code={{code}}
Content-Type: application/json

{
    "Text": "coche",
    "SourceLanguage": "Spanish",
    "DestinationLanguage": "Russian",
    "ActiveDictionaries": [
        "Spanish"
    ],
    "Version": "2"
}

> {%
  client.test('Reject the obsolete dictionary lookup payload', () => {
    client.assert(response.status === 400, "Response status is 400");
  });
%}
