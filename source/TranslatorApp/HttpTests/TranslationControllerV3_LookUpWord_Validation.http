// Language-independent validation and authorization for LookUpWord.
// SourceLanguage is numeric: 0 = Danish, 1 = Spanish.

### Reject a model with no contexts

POST {{HostAddress}}/api/v3/Translation/LookUpWord?code={{code}}
Content-Type: application/json

{
    "word": "haj",
    "sourceLanguage": 0,
    "soundUrl": null,
    "soundFileName": null,
    "definition": {
        "headword": {
            "original": "haj",
            "english": null,
            "translation": null
        },
        "partOfSpeech": "verbum",
        "endings": "",
        "contexts": []
    },
    "variants": [],
    "expressions": []
}

> {%
  client.test('Reject a model with no contexts', () => {
    client.assert(response.status === 400, "Response status is 400");
    client.assert(typeof response.body === "string" && response.body.includes("Contexts"), "Validation identifies contexts");
  });
%}

### Reject an empty original headword

POST {{HostAddress}}/api/v3/Translation/LookUpWord?code={{code}}
Content-Type: application/json

{
    "word": "haj",
    "sourceLanguage": 0,
    "soundUrl": null,
    "soundFileName": null,
    "definition": {
        "headword": {
            "original": "",
            "english": null,
            "translation": null
        },
        "partOfSpeech": "verbum",
        "endings": "",
        "contexts": [
            {
                "contextEN": "",
                "position": "1",
                "meanings": [
                    {
                        "original": "stor bruskfisk",
                        "translation": null,
                        "alphabeticalPosition": "1",
                        "tag": null,
                        "imageUrl": null,
                        "lookupUrl": null,
                        "examples": []
                    }
                ]
            }
        ]
    },
    "variants": [],
    "expressions": []
}

> {%
  client.test('Reject an empty original headword', () => {
    client.assert(response.status === 400, "Response status is 400");
  });
%}

